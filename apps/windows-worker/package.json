{
  "name": "@feishu-agent/windows-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "tsx --env-file-if-exists=../../.env watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "verify:agent-cli": "tsx --env-file-if-exists=../../.env src/verify-agent-cli.ts"
  },
  "dependencies": {
    "@feishu-agent/contracts": "workspace:*",
    "@feishu-agent/executors": "workspace:*",
    "@feishu-agent/observability": "workspace:*",
    "fastify": "^5.6.2",
    "zod": "4.1.12"
  }
}

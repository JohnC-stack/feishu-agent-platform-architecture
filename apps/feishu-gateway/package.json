{
  "name": "@feishu-agent/feishu-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --sourcemap --clean",
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "verify:pipeline": "tsx --env-file-if-exists=../../.env src/verify-pipeline.ts",
    "verify:wss": "tsx --env-file-if-exists=../../.env src/verify-wss.ts"
  },
  "dependencies": {
    "@feishu-agent/credentials": "workspace:*",
    "@feishu-agent/observability": "workspace:*",
    "@feishu-agent/transport": "workspace:*",
    "@larksuiteoapi/node-sdk": "1.73.0",
    "fastify": "^5.6.2",
    "ioredis": "5.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/ws": "8.18.1",
    "ws": "8.21.3"
  }
}

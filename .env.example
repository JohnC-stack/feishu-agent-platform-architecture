NODE_ENV=development
LOG_LEVEL=info

CONTROL_API_HOST=127.0.0.1
CONTROL_API_PORT=3000
FEISHU_GATEWAY_HOST=127.0.0.1
FEISHU_GATEWAY_PORT=3100
WINDOWS_WORKER_HOST=127.0.0.1
WINDOWS_WORKER_PORT=3200

POSTGRES_DB=feishu_agent
POSTGRES_USER=feishu_agent
POSTGRES_PASSWORD=local-development-only
POSTGRES_PORT=5432
DATABASE_URL=postgres://feishu_agent:local-development-only@127.0.0.1:5432/feishu_agent

REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# P2 调度队列。任务正文保存在 PostgreSQL，Redis 队列只保存任务引用和路由元数据。
TASK_QUEUE_NAME=feishu-agent-tasks
TASK_QUEUE_CONCURRENCY=4
TASK_QUEUE_TIMEOUT_MS=300000
TASK_QUEUE_ATTEMPTS=3
TASK_QUEUE_BACKOFF_MS=1000
TASK_QUEUE_LOCK_DURATION_MS=30000
TASK_QUEUE_STALLED_INTERVAL_MS=30000
TASK_QUEUE_MAX_STALLED_COUNT=1

# P1 才启用真实飞书凭据。不要把真实值提交到 Git。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_WSS_CONNECT_TIMEOUT_MS=30000
FEISHU_WSS_HANDSHAKE_TIMEOUT_MS=10000
FEISHU_WSS_PING_TIMEOUT_SECONDS=10
FEISHU_EVENT_LEASE_SECONDS=60
FEISHU_EVENT_DEDUP_TTL_SECONDS=86400
FEISHU_RATE_LIMIT_MAX=20
FEISHU_RATE_LIMIT_WINDOW_SECONDS=60
FEISHU_REPLY_CHUNK_CHARACTERS=4000
FEISHU_OPENAPI_MAX_ATTEMPTS=3
FEISHU_OPENAPI_RETRY_BASE_MS=250

NODE_ENV=production
LOG_LEVEL=info
WINDOWS_WORKER_HOST=0.0.0.0
WINDOWS_WORKER_PORT=3200
API_AGENT_ENABLED=false
CREDENTIAL_TARGET_PREFIXES=FeishuAgent/
CREDENTIAL_FILE_ROOTS=C:/ProgramData/FeishuAgent/secrets
AGENT_TASK_ROOT=C:/ProgramData/FeishuAgent/tasks
AGENT_AUTHORIZED_WORKSPACE_ROOTS=D:/Codex/coding
WINDOWS_WORKER_TLS_ENABLED=true
WINDOWS_WORKER_TLS_CA_PATH=C:/ProgramData/FeishuAgent/tls/ca.pem
WINDOWS_WORKER_TLS_CERT_PATH=C:/ProgramData/FeishuAgent/tls/worker.pem
WINDOWS_WORKER_TLS_KEY_PATH=C:/ProgramData/FeishuAgent/tls/worker-key.pem
WINDOWS_WORKER_TLS_REQUIRE_CLIENT_CERT=true

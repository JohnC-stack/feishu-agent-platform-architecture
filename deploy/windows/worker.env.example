NODE_ENV=production
LOG_LEVEL=info
WINDOWS_WORKER_HOST=0.0.0.0
WINDOWS_WORKER_PORT=3200
API_AGENT_ENABLED=false
CREDENTIAL_TARGET_PREFIXES=FeishuAgent/
CREDENTIAL_FILE_ROOTS=D:/FeishuAgent/data/secrets
CREDENTIAL_FILE_ENFORCE_POSIX_PERMISSIONS=true
FEISHU_APP_ID=replace-with-feishu-app-id
FEISHU_APP_SECRET=filecred://D:/FeishuAgent/data/secrets/feishu-app-secret
FEISHU_ALLOWED_DOCUMENT_IDS=replace-with-feishu-document-ids
FEISHU_ALLOWED_BITABLE_APP_TOKENS=replace-with-feishu-bitable-tokens
FEISHU_ALLOWED_CHAT_IDS=replace-with-feishu-chat-ids
FEISHU_ALLOWED_USER_IDS=replace-with-feishu-user-ids
GITLAB_BASE_URL=replace-with-gitlab-base-url
GITLAB_TOKEN=replace-with-gitlab-token-reference
GITLAB_ALLOWED_PROJECTS=replace-with-gitlab-projects
CONFLUENCE_BASE_URL=replace-with-confluence-base-url
CONFLUENCE_USERNAME=replace-with-confluence-username
CONFLUENCE_PASSWORD=replace-with-confluence-password-reference
CONFLUENCE_CLI_WRAPPER=replace-with-confluence-cli-wrapper
CONFLUENCE_ALLOWED_SPACE_KEYS=replace-with-confluence-space-keys
CONFLUENCE_ALLOWED_PAGE_IDS=replace-with-confluence-page-ids
AGENT_TASK_ROOT=D:/FeishuAgent/data/tasks
AGENT_AUTHORIZED_WORKSPACE_ROOTS=D:/Codex/coding
WINDOWS_WORKER_TLS_ENABLED=true
WINDOWS_WORKER_TLS_CA_PATH=D:/FeishuAgent/data/tls/ca.pem
WINDOWS_WORKER_TLS_CERT_PATH=D:/FeishuAgent/data/tls/worker.pem
WINDOWS_WORKER_TLS_KEY_PATH=D:/FeishuAgent/data/tls/worker-key.pem
WINDOWS_WORKER_TLS_REQUIRE_CLIENT_CERT=true

NODE_ENV=production
LOG_LEVEL=info
FEISHU_GATEWAY_HOST=0.0.0.0
FEISHU_GATEWAY_PORT=3100
FEISHU_APP_ID=replace-with-app-id
FEISHU_APP_SECRET=filecred://C:/ProgramData/FeishuAgent/secrets/feishu-app-secret
REDIS_URL=filecred://C:/ProgramData/FeishuAgent/secrets/redis-url
CREDENTIAL_TARGET_PREFIXES=FeishuAgent/
CREDENTIAL_FILE_ROOTS=C:/ProgramData/FeishuAgent/secrets
CONTROL_API_URL=https://feishu-agent-windows.internal:443
CONTROL_PLANE_MTLS_REQUIRED=true
CONTROL_PLANE_MTLS_CA_PATH=C:/ProgramData/FeishuAgent/tls/ca.pem
CONTROL_PLANE_MTLS_CERT_PATH=C:/ProgramData/FeishuAgent/tls/windows-client.pem
CONTROL_PLANE_MTLS_KEY_PATH=C:/ProgramData/FeishuAgent/tls/windows-client-key.pem
CONTROL_PLANE_MTLS_ALLOWED_HOSTS=feishu-agent-windows.internal
FEISHU_GATEWAY_TLS_ENABLED=true
FEISHU_GATEWAY_TLS_CA_PATH=C:/ProgramData/FeishuAgent/tls/ca.pem
FEISHU_GATEWAY_TLS_CERT_PATH=C:/ProgramData/FeishuAgent/tls/gateway.pem
FEISHU_GATEWAY_TLS_KEY_PATH=C:/ProgramData/FeishuAgent/tls/gateway-key.pem
FEISHU_GATEWAY_TLS_REQUIRE_CLIENT_CERT=true
REDIS_MTLS_REQUIRED=true
REDIS_MTLS_CA_PATH=C:/ProgramData/FeishuAgent/tls/ca.pem
REDIS_MTLS_CERT_PATH=C:/ProgramData/FeishuAgent/tls/windows-client.pem
REDIS_MTLS_KEY_PATH=C:/ProgramData/FeishuAgent/tls/windows-client-key.pem
REDIS_MTLS_ALLOWED_HOSTS=redis.feishu-agent.internal
REDIS_MTLS_SERVER_NAME=redis.feishu-agent.internal

<service>
  <id>FeishuAgentGateway</id>
  <name>Feishu Agent Gateway</name>
  <description>Feishu WSS gateway and approval callback service.</description>
  <executable>__NODE_PATH__</executable>
  <arguments>--env-file=&quot;__ENV_PATH__&quot; &quot;__APP_PATH__&quot;</arguments>
  <workingdirectory>__WORKING_DIRECTORY__</workingdirectory>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <serviceaccount>
    <domain>NT AUTHORITY</domain>
    <user>LocalService</user>
    <allowservicelogon>true</allowservicelogon>
  </serviceaccount>
  <onfailure action="restart" delay="10 sec" />
  <onfailure action="restart" delay="30 sec" />
  <onfailure action="restart" delay="60 sec" />
  <resetfailure>1 hour</resetfailure>
  <stoptimeout>30 sec</stoptimeout>
  <logpath>__LOG_PATH__</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <zipDateFormat>yyyyMM</zipDateFormat>
    <keepFiles>14</keepFiles>
  </log>
</service>

# Non-secret production settings. Copy to production.env; never put passwords or tokens here.
COMPOSE_PROJECT_NAME=feishu-agent
VM_BIND_ADDRESS=192.168.100.10
EDGE_BIND_PORT=443
REDIS_BIND_PORT=6379
WINDOWS_HOST_ADDRESS=192.168.100.1
WINDOWS_WORKER_TARGET_PORT=3200
FEISHU_GATEWAY_TARGET_PORT=3100
ADMIN_DOMAIN=feishu-agent.internal
WINDOWS_CONTROL_DOMAIN=feishu-agent-windows.internal
SECRETS_DIR=/opt/feishu-agent/secrets
TLS_DIR=/opt/feishu-agent/tls
BACKUP_DIR=/opt/feishu-agent/backups
LINUX_SECRET_GID=1999

NODE_ENV=production
LOG_LEVEL=info
API_AGENT_ENABLED=false
CREDENTIAL_TARGET_PREFIXES=FeishuAgent/
CREDENTIAL_FILE_ROOTS=/run/secrets
CREDENTIAL_FILE_ENFORCE_POSIX_PERMISSIONS=true
NODE_EXTRA_CA_CERTS=/run/secrets/internal-ca

POSTGRES_DB=feishu_agent
POSTGRES_USER=feishu_agent

FEISHU_APP_ID=replace-with-app-id
FEISHU_OAUTH_ENABLED=true
FEISHU_OAUTH_REDIRECT_URI=https://feishu-agent.internal/v1/admin/auth/feishu/callback
FEISHU_OAUTH_FRONTEND_URL=https://feishu-agent.internal/
FEISHU_OAUTH_SCOPES=

WINDOWS_SERVICE_MTLS_REQUIRED=true
WINDOWS_SERVICE_MTLS_CA_PATH=/run/secrets/internal-ca
WINDOWS_SERVICE_MTLS_CERT_PATH=/run/secrets/linux-client-cert
WINDOWS_SERVICE_MTLS_KEY_PATH=/run/secrets/linux-client-key
WINDOWS_SERVICE_MTLS_ALLOWED_HOSTS=windows-host.internal
WINDOWS_SERVICE_MTLS_ENFORCE_POSIX_PERMISSIONS=true
REDIS_MTLS_REQUIRED=true
REDIS_MTLS_CA_PATH=/run/secrets/internal-ca
REDIS_MTLS_CERT_PATH=/run/secrets/linux-client-cert
REDIS_MTLS_KEY_PATH=/run/secrets/linux-client-key
REDIS_MTLS_ALLOWED_HOSTS=redis
REDIS_MTLS_SERVER_NAME=redis
REDIS_MTLS_ENFORCE_POSIX_PERMISSIONS=true

GOVERNANCE_ADMIN_USER_IDS=
GOVERNANCE_READER_USER_IDS=
GOVERNANCE_OPERATOR_USER_IDS=
GOVERNANCE_APPROVER_USER_IDS=
GOVERNANCE_AUDITOR_USER_IDS=
GOVERNANCE_APPROVAL_TTL_SECONDS=3600
GOVERNANCE_AUDIT_RETENTION_DAYS=365

TASK_QUEUE_NAME=feishu-agent-tasks
TASK_QUEUE_CONCURRENCY=4
TASK_QUEUE_TIMEOUT_MS=300000
TASK_QUEUE_ATTEMPTS=3
TASK_QUEUE_BACKOFF_MS=1000

GF_SERVER_ROOT_URL=https://feishu-agent.internal/ops/grafana/
GF_SERVER_SERVE_FROM_SUB_PATH=true
GF_AUTH_ANONYMOUS_ENABLED=false
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
GF_ANALYTICS_CHECK_FOR_PLUGIN_UPDATES=false

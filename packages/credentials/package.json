{
  "name": "@feishu-agent/credentials",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "migrate:p5": "tsx --env-file-if-exists=../../.env src/migrate-p5-secrets.ts",
    "verify:windows": "tsx --env-file-if-exists=../../.env src/verify-windows-credential.ts"
  },
  "dependencies": {
    "@feishu-agent/contracts": "workspace:*"
  }
}

{
  "name": "@feishu-agent/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/migrate.ts --format esm --dts --clean",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "verify:p2": "tsx --env-file-if-exists=../../.env src/verify-p2-persistence.ts",
    "verify:concurrency": "tsx --env-file-if-exists=../../.env src/verify-p2-concurrency.ts",
    "verify:p3": "tsx --env-file-if-exists=../../.env src/verify-p3-persistence.ts",
    "verify:p5": "tsx --env-file-if-exists=../../.env src/verify-p5-governance.ts",
    "verify:p5-live": "tsx --env-file-if-exists=../../.env src/verify-p5-live-approval.ts",
    "verify:p6": "tsx --env-file-if-exists=../../.env src/verify-p6-operations.ts"
  },
  "dependencies": {
    "@feishu-agent/contracts": "workspace:*",
    "@feishu-agent/policy": "workspace:*",
    "postgres": "^3.4.7"
  }
}
